<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.helian.focus.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Focus</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- 正常退出（退出码 0）不重开；被强行结束、崩溃才重开 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.helian.focus</string>
	</array>
</dict>
</plist>
